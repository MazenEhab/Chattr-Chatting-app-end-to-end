<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Confirm your Chattr email</title>
</head>
<body style="margin:0;padding:0;background:#FAF6F1;font-family:Arial,Helvetica,sans-serif;color:#2B2D42;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#FAF6F1;padding:24px 12px;">
    <tr><td align="center">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:660px;background:#FFFFFF;border:1px solid #E8DDD0;border-radius:24px;overflow:hidden;">
        <tr>
          <td background="cid:chattr-pattern" style="padding:28px 32px;background-color:#E99475;background-image:url('cid:chattr-pattern');background-repeat:repeat;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td valign="middle" width="58">
                  <img src="cid:chattr-logo" width="56" height="56" alt="Chattr" style="display:block;width:56px;height:56px;border:0;border-radius:16px;background:#FFFFFF;padding:5px;">
                </td>
                <td valign="middle" style="padding-left:12px;">
                  <span style="font-size:28px;line-height:34px;font-weight:700;color:#2B2D42;">Chattr</span>
                </td>
                <td align="right" valign="middle">
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                    <tr><td style="background:#FFFFFF;border-radius:16px 16px 4px 16px;padding:10px 14px;color:#2B2D42;font-size:13px;line-height:18px;white-space:nowrap;">
                      Are you up? 👀
                    </td></tr>
                    <tr><td align="right" style="padding-top:5px;">
                      <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                        <tr><td style="background:#F8D7C8;border-radius:14px 14px 4px 14px;padding:7px 11px;color:#2B2D42;font-size:12px;line-height:16px;white-space:nowrap;">
                          Always ☕ <span style="color:#3D5A80;font-weight:bold;">✓✓</span>
                        </td></tr>
                      </table>
                    </td></tr>
                  </table>
                </td>
              </tr>
            </table>
          </td>
        </tr>
        <tr>
          <td style="padding:36px 32px 8px;">
            <h1 style="margin:0 0 12px;font-size:28px;line-height:34px;font-weight:700;color:#2B2D42;">Confirm your email</h1>
            <p style="margin:0 0 20px;font-size:16px;line-height:26px;color:#2B2D42;">Hi <%= name %>, enter this code in Chattr to finish creating your account.</p>
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:8px 0 20px;">
              <tr><td align="center" style="background:#FAF6F1;border:2px dashed #E0B8A8;border-radius:16px;padding:20px 20px 20px 30px;font-family:Consolas,monospace;font-size:36px;line-height:44px;font-weight:700;letter-spacing:10px;color:#2B2D42;"><%= code %></td></tr>
            </table>
            <p style="margin:0 0 12px;font-size:14px;line-height:22px;color:#666A7E;">The code expires in <%= minutes %> minutes. Never share it with anyone, including us.</p>
            <p style="margin:0 0 12px;font-size:14px;line-height:22px;color:#666A7E;">Didn't sign up? You can safely ignore this email.</p>
          </td>
        </tr>
        <tr><td style="padding:24px 32px 32px;border-top:1px solid #E8DDD0;font-size:13px;line-height:20px;color:#666A7E;">
          <strong style="color:#2B2D42;">Chattr</strong> · Small talk, made cozy.<br>
          This email was sent to <%= email %>.
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
